+    previous_position=isnan(previous_pos) ? nothing : previous_pos
+    if old===nothing
+        if previous_branching===nothing
+            if previous_position===nothing
+                return AMAPSim.sample_immediate_markov_state(rng,zone,age,pos,nothing;previous_branching=nothing,previous_position=nothing)
+            else
+                return AMAPSim.sample_immediate_markov_state(rng,zone,age,pos,nothing;previous_branching=nothing,previous_position=previous_position)
+            end
+        else
+            if previous_position===nothing
+                return AMAPSim.sample_immediate_markov_state(rng,zone,age,pos,nothing;previous_branching=previous_branching,previous_position=nothing)
+            else
+                return AMAPSim.sample_immediate_markov_state(rng,zone,age,pos,nothing;previous_branching=previous_branching,previous_position=previous_position)
+            end
+        end
+    else
+        if previous_branching===nothing
+            if previous_position===nothing
+                return AMAPSim.sample_immediate_markov_state(rng,zone,age,pos,old;previous_branching=nothing,previous_position=nothing)
+            else
+                return AMAPSim.sample_immediate_markov_state(rng,zone,age,pos,old;previous_branching=nothing,previous_position=previous_position)
+            end
+        else
+            if previous_position===nothing
+                return AMAPSim.sample_immediate_markov_state(rng,zone,age,pos,old;previous_branching=previous_branching,previous_position=nothing)
+            else
+                return AMAPSim.sample_immediate_markov_state(rng,zone,age,pos,old;previous_branching=previous_branching,previous_position=previous_position)
+            end
+        end
+    end
+end
